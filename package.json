{
  "name": "bisql",
  "displayName": "BiSql",
  "description": "Schema-aware validation, IntelliSense, hover and format for SQL Server, MySQL, PostgreSQL, Supabase, and BigQuery queries embedded in Python strings.",
  "version": "0.4.7",
  "publisher": "brachya",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "python",
    "sql",
    "mssql",
    "sql server",
    "mysql",
    "mariadb",
    "postgres",
    "postgresql",
    "bigquery",
    "intellisense"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:python",
    "onLanguage:sql"
  ],
  "contributes": {
    "configuration": {
      "title": "BiSql",
      "properties": {
        "bisql.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable SQL validation, completion and hover inside Python files and SQL files."
        },
        "bisql.engine": {
          "type": "string",
          "enum": [
            "mssql",
            "mysql",
            "postgres",
            "bigquery"
          ],
          "default": "mssql",
          "enumDescriptions": [
            "Keep using Microsoft SQL Server",
            "Use MySQL or MariaDB instead for this connection",
            "Use PostgreSQL instead for this connection",
            "Use BigQuery instead for this connection"
          ],
          "description": "Which database engine to use. SQL Server, MySQL, PostgreSQL, and BigQuery are supported."
        },
        "bisql.connections": {
          "type": "array",
          "default": [],
          "description": "Saved database logins. Passwords stay in the OS keychain, not in this list."
        },
        "bisql.activeConnectionId": {
          "type": "string",
          "default": "",
          "markdownDescription": "Which saved login is active. A workspace value pins this project to that login."
        },
        "bisql.loginKind": {
          "type": "string",
          "enum": [
            "mssql",
            "mysql",
            "postgres",
            "supabase",
            "bigquery"
          ],
          "default": "mssql",
          "enumDescriptions": [
            "SQL Server login fields",
            "MySQL login fields",
            "PostgreSQL login fields",
            "Supabase connection URL",
            "BigQuery project and datasets (Application Default Credentials)"
          ],
          "markdownDescription": "Which login page to show. Supabase still uses the PostgreSQL engine. BigQuery uses the project id in `bisql.server` and datasets in `bisql.database` / `bisql.databases`."
        },
        "bisql.server": {
          "type": "string",
          "default": "",
          "description": "Database host name or IP. For SQL Server, named instances use host\\\\INSTANCE. For BigQuery this is the Google Cloud project id."
        },
        "bisql.database": {
          "type": "string",
          "default": "",
          "description": "Default database for the live connection, dry-run, and when the same table name exists in more than one selected database. For BigQuery this is the default dataset, or project.dataset for a dataset in another project."
        },
        "bisql.databases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Databases to load schema from. The default database is always included. When the same table name exists in more than one, the default database is used unless the name is qualified. For BigQuery these are datasets in the home project, or `project.dataset` for extra projects."
        },
        "bisql.user": {
          "type": "string",
          "default": "",
          "description": "Database login name. A read-only login is strongly recommended."
        },
        "bisql.password": {
          "type": "string",
          "default": "",
          "markdownDescription": "Fallback password, stored in plain text in settings. Prefer the login page or **Set Password**, which stores the password in the OS keychain."
        },
        "bisql.port": {
          "type": "number",
          "default": 1433,
          "minimum": 1,
          "maximum": 65535,
          "markdownDescription": "TCP port. Defaults: SQL Server `1433`, MySQL `3306`, PostgreSQL `5432`."
        },
        "bisql.encrypt": {
          "type": "boolean",
          "default": true,
          "description": "Encrypt the connection (TLS). For local SQL Server you may need Trust server certificate. For MySQL and PostgreSQL this maps to ssl."
        },
        "bisql.trustServerCertificate": {
          "type": "boolean",
          "default": false,
          "description": "Trust a self-signed server certificate (SQL Server) or skip TLS cert verification (MySQL / PostgreSQL)."
        },
        "bisql.connectionTimeout": {
          "type": "number",
          "default": 15000,
          "minimum": 1000,
          "description": "Connection and request timeout in milliseconds."
        },
        "bisql.schemaRefreshMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "markdownDescription": "How often to refresh cached schema metadata, in minutes. Set to 0 to refresh only on demand. For BigQuery, the timer refreshes the **home** project only; use **Refresh Database Schema** to pick other cached projects."
        },
        "bisql.validateOnType": {
          "type": "boolean",
          "default": true,
          "description": "Run the fast offline metadata check while typing. The database is never contacted for this pass."
        },
        "bisql.dryRunOnSave": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "On open/save, dry-run the query: SQL Server uses `SET NOEXEC ON`; MySQL and PostgreSQL use `EXPLAIN` (parse/plan only, no data changes); BigQuery uses a dry-run job (no bytes billed)."
        },
        "bisql.promptQuickSuggestions": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Offer, once, to enable `editor.quickSuggestions.strings` for Python. Without that setting VS Code will not pop the suggestion list while you type letters inside a string."
        },
        "bisql.cacheSchemaToDisk": {
          "type": "boolean",
          "default": true,
          "description": "Save a snapshot of the schema to local disk so suggestions work immediately at startup and while offline. Table and column names are written to the extension's global storage folder."
        },
        "bisql.queryMaxRows": {
          "type": "number",
          "default": 1000,
          "minimum": 1,
          "maximum": 10000,
          "description": "Rows per page for Run Selected SQL. Default 1000. Use Next/Previous in the results tab to see more. Click a column header to sort."
        },
        "bisql.bigqueryConfirmScanMb": {
          "type": "number",
          "default": 1024,
          "minimum": 0,
          "markdownDescription": "Ask before running a BigQuery query whose dry-run estimate is above this many megabytes. `LIMIT` does not reduce bytes scanned. Set to `0` to ask for every scan. The MCP tool `bisql_run_sql` refuses instead of asking unless `allow_large_scan` is true."
        },
        "bisql.formatKeywordCase": {
          "type": "string",
          "enum": [
            "upper",
            "lower",
            "preserve"
          ],
          "default": "upper",
          "enumDescriptions": [
            "UPPERCASE keywords, functions, and types (SELECT, COUNT, INT)",
            "lowercase keywords, functions, and types (select, count, int)",
            "Leave keyword, function, and type case as written"
          ],
          "description": "Case for SQL keywords, functions, and types when formatting. Table and column names stay as written."
        },
        "bisql.formatTabWidth": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 8,
          "description": "Spaces per indent level when formatting SQL inside Python strings and in SQL files."
        },
        "bisql.mcpEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Register a localhost MCP server so Cursor's agent can use the live BiSql connection and schema cache."
        },
        "bisql.mcpAllowMutating": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Allow the Cursor agent to run `INSERT` / `UPDATE` / `DELETE` / DDL through MCP. The tool call must also pass `allow_mutating: true`. Prefer a read-only database login."
        },
        "bisql.mcpMaxResultRows": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 1000,
          "description": "Max rows returned to the Cursor agent in one MCP tool reply. The results tab can still show bisql.queryMaxRows."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bisql",
          "title": "BiSql",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "bisql": [
        {
          "id": "bisql.explorer",
          "name": "Database"
        }
      ]
    },
    "commands": [
      {
        "command": "bisql.openConnectionPanel",
        "title": "Open Connection / Login",
        "category": "BiSql",
        "icon": "$(key)"
      },
      {
        "command": "bisql.switchConnection",
        "title": "Switch Connection",
        "category": "BiSql",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "bisql.switchProject",
        "title": "Switch Project",
        "category": "BiSql",
        "icon": "$(globe)"
      },
      {
        "command": "bisql.openSchemaExplorer",
        "title": "Browse Cached Schema",
        "category": "BiSql",
        "icon": "$(table)"
      },
      {
        "command": "bisql.explorer.switchConnection",
        "title": "Switch to This Connection",
        "category": "BiSql",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "bisql.explorer.editConnection",
        "title": "Edit Connection",
        "category": "BiSql",
        "icon": "$(edit)"
      },
      {
        "command": "bisql.explorer.addConnection",
        "title": "Add Connection",
        "category": "BiSql",
        "icon": "$(add)"
      },
      {
        "command": "bisql.explorer.testConnection",
        "title": "Test Connection",
        "category": "BiSql"
      },
      {
        "command": "bisql.explorer.pinWorkspace",
        "title": "Pin to Workspace",
        "category": "BiSql",
        "icon": "$(pinned)"
      },
      {
        "command": "bisql.explorer.switchProject",
        "title": "Switch to This Project",
        "category": "BiSql",
        "icon": "$(globe)"
      },
      {
        "command": "bisql.explorer.refreshProjects",
        "title": "Refresh Projects",
        "category": "BiSql",
        "icon": "$(refresh)"
      },
      {
        "command": "bisql.explorer.refreshProjectSchema",
        "title": "Refresh Schema for This Project",
        "category": "BiSql",
        "icon": "$(refresh)"
      },
      {
        "command": "bisql.explorer.pinProjectCache",
        "title": "Pin Project for Schema Cache",
        "category": "BiSql",
        "icon": "$(pin)"
      },
      {
        "command": "bisql.explorer.unpinProjectCache",
        "title": "Remove Project from Schema Cache",
        "category": "BiSql",
        "icon": "$(pinned-dirty)"
      },
      {
        "command": "bisql.explorer.previewTable",
        "title": "Preview Data",
        "category": "BiSql",
        "icon": "$(play)"
      },
      {
        "command": "bisql.explorer.openSchemaExplorer",
        "title": "Open Cached Schema",
        "category": "BiSql",
        "icon": "$(table)"
      },
      {
        "command": "bisql.explorer.revealInSidebar",
        "title": "Reveal in Sidebar",
        "category": "BiSql"
      },
      {
        "command": "bisql.explorer.copyName",
        "title": "Copy Name",
        "category": "BiSql",
        "icon": "$(copy)"
      },
      {
        "command": "bisql.explorer.copySelect",
        "title": "Copy SELECT *",
        "category": "BiSql"
      },
      {
        "command": "bisql.explorer.refreshSchema",
        "title": "Refresh Schema",
        "category": "BiSql",
        "icon": "$(refresh)"
      },
      {
        "command": "bisql.explorer.filterDatabases",
        "title": "Filter Sidebar Databases",
        "category": "BiSql",
        "icon": "$(filter)"
      },
      {
        "command": "bisql.setPassword",
        "title": "Set Password",
        "category": "BiSql"
      },
      {
        "command": "bisql.clearPassword",
        "title": "Clear Stored Password",
        "category": "BiSql"
      },
      {
        "command": "bisql.refreshSchema",
        "title": "Refresh Database Schema",
        "category": "BiSql"
      },
      {
        "command": "bisql.testConnection",
        "title": "Test Connection",
        "category": "BiSql"
      },
      {
        "command": "bisql.validateCurrentFile",
        "title": "Validate Current File",
        "category": "BiSql"
      },
      {
        "command": "bisql.validateProject",
        "title": "Validate Project",
        "category": "BiSql"
      },
      {
        "command": "bisql.enableInlineSuggestions",
        "title": "Enable Suggestions Inside Python Strings",
        "category": "BiSql"
      },
      {
        "command": "bisql.clearSchemaCache",
        "title": "Clear Cached Schema Snapshot",
        "category": "BiSql"
      },
      {
        "command": "bisql.runSelectedSql",
        "title": "Run Selected SQL",
        "category": "BiSql",
        "icon": "$(play)"
      },
      {
        "command": "bisql.formatSqlInFile",
        "title": "Format SQL in File",
        "category": "BiSql",
        "icon": "$(symbol-ruler)"
      },
      {
        "command": "bisql.formatSqlAt",
        "title": "Format SQL",
        "category": "BiSql",
        "icon": "$(symbol-ruler)"
      },
      {
        "command": "bisql.explainSqlAt",
        "title": "Explain SQL",
        "category": "BiSql",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "bisql.validateSqlAt",
        "title": "Validate SQL",
        "category": "BiSql",
        "icon": "$(verified)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "bisql.openConnectionPanel"
        },
        {
          "command": "bisql.switchConnection"
        },
        {
          "command": "bisql.switchProject"
        },
        {
          "command": "bisql.openSchemaExplorer"
        },
        {
          "command": "bisql.explorer.switchConnection",
          "when": "false"
        },
        {
          "command": "bisql.explorer.editConnection",
          "when": "false"
        },
        {
          "command": "bisql.explorer.addConnection",
          "when": "false"
        },
        {
          "command": "bisql.explorer.testConnection",
          "when": "false"
        },
        {
          "command": "bisql.explorer.pinWorkspace",
          "when": "false"
        },
        {
          "command": "bisql.explorer.switchProject",
          "when": "false"
        },
        {
          "command": "bisql.explorer.refreshProjects",
          "when": "false"
        },
        {
          "command": "bisql.explorer.refreshProjectSchema",
          "when": "false"
        },
        {
          "command": "bisql.explorer.pinProjectCache",
          "when": "false"
        },
        {
          "command": "bisql.explorer.unpinProjectCache",
          "when": "false"
        },
        {
          "command": "bisql.explorer.previewTable",
          "when": "false"
        },
        {
          "command": "bisql.explorer.openSchemaExplorer",
          "when": "false"
        },
        {
          "command": "bisql.explorer.revealInSidebar",
          "when": "false"
        },
        {
          "command": "bisql.explorer.copyName",
          "when": "false"
        },
        {
          "command": "bisql.explorer.copySelect",
          "when": "false"
        },
        {
          "command": "bisql.explorer.refreshSchema",
          "when": "false"
        },
        {
          "command": "bisql.explorer.filterDatabases",
          "when": "false"
        },
        {
          "command": "bisql.setPassword"
        },
        {
          "command": "bisql.clearPassword"
        },
        {
          "command": "bisql.refreshSchema"
        },
        {
          "command": "bisql.testConnection"
        },
        {
          "command": "bisql.validateCurrentFile"
        },
        {
          "command": "bisql.validateProject"
        },
        {
          "command": "bisql.enableInlineSuggestions"
        },
        {
          "command": "bisql.clearSchemaCache"
        },
        {
          "command": "bisql.runSelectedSql"
        },
        {
          "command": "bisql.formatSqlInFile"
        },
        {
          "command": "bisql.formatSqlAt",
          "when": "false"
        },
        {
          "command": "bisql.explainSqlAt",
          "when": "false"
        },
        {
          "command": "bisql.validateSqlAt",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "bisql.runSelectedSql",
          "when": "editorHasSelection || editorLangId == sql",
          "group": "bisql@1"
        },
        {
          "command": "bisql.formatSqlInFile",
          "when": "editorLangId == python || editorLangId == sql",
          "group": "bisql@2"
        }
      ],
      "view/title": [
        {
          "command": "bisql.refreshSchema",
          "when": "view == bisql.explorer",
          "group": "navigation@1"
        },
        {
          "command": "bisql.explorer.addConnection",
          "when": "view == bisql.explorer",
          "group": "navigation@2"
        },
        {
          "command": "bisql.openSchemaExplorer",
          "when": "view == bisql.explorer",
          "group": "navigation@3"
        },
        {
          "command": "bisql.explorer.filterDatabases",
          "when": "view == bisql.explorer",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "bisql.explorer.switchConnection",
          "when": "view == bisql.explorer && viewItem == connectionInactive",
          "group": "0_nav@1"
        },
        {
          "command": "bisql.explorer.editConnection",
          "when": "view == bisql.explorer && viewItem =~ /^connection(Active|Inactive)$/",
          "group": "0_nav@2"
        },
        {
          "command": "bisql.explorer.testConnection",
          "when": "view == bisql.explorer && viewItem =~ /^connection(Active|Inactive)$/",
          "group": "0_nav@3"
        },
        {
          "command": "bisql.explorer.refreshSchema",
          "when": "view == bisql.explorer && viewItem == connectionActive",
          "group": "0_nav@4"
        },
        {
          "command": "bisql.explorer.pinWorkspace",
          "when": "view == bisql.explorer && viewItem == connectionActive",
          "group": "0_nav@5"
        },
        {
          "command": "bisql.explorer.filterDatabases",
          "when": "view == bisql.explorer && viewItem =~ /^connection(Active|Inactive)$/",
          "group": "inline"
        },
        {
          "command": "bisql.explorer.filterDatabases",
          "when": "view == bisql.explorer && viewItem =~ /^connection(Active|Inactive)$/",
          "group": "1_filter@1"
        },
        {
          "command": "bisql.explorer.addConnection",
          "when": "view == bisql.explorer && viewItem == connectionAdd",
          "group": "0_nav@1"
        },
        {
          "command": "bisql.explorer.switchProject",
          "when": "view == bisql.explorer && viewItem =~ /^project(Cached)?$/",
          "group": "0_nav@1"
        },
        {
          "command": "bisql.explorer.refreshProjects",
          "when": "view == bisql.explorer && viewItem == projects",
          "group": "0_nav@1"
        },
        {
          "command": "bisql.explorer.refreshProjectSchema",
          "when": "view == bisql.explorer && viewItem =~ /^project(Home)?Cached$/",
          "group": "0_nav@1"
        },
        {
          "command": "bisql.explorer.pinProjectCache",
          "when": "view == bisql.explorer && viewItem == project",
          "group": "0_nav@2"
        },
        {
          "command": "bisql.explorer.unpinProjectCache",
          "when": "view == bisql.explorer && viewItem == projectCached",
          "group": "0_nav@2"
        },
        {
          "command": "bisql.explorer.refreshSchema",
          "when": "view == bisql.explorer && viewItem == database",
          "group": "0_nav@1"
        },
        {
          "command": "bisql.explorer.previewTable",
          "when": "view == bisql.explorer && viewItem =~ /^(table|view)$/",
          "group": "0_nav@1"
        },
        {
          "command": "bisql.explorer.openSchemaExplorer",
          "when": "view == bisql.explorer && viewItem =~ /^(table|view)$/",
          "group": "0_nav@2"
        },
        {
          "command": "bisql.explorer.copySelect",
          "when": "view == bisql.explorer && viewItem =~ /^(table|view)$/",
          "group": "1_copy@2"
        },
        {
          "command": "bisql.explorer.copyName",
          "when": "view == bisql.explorer && viewItem =~ /^(connectionActive|connectionInactive|project|database|schema|table|view|column|columnPK)$/",
          "group": "1_copy@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "bisql.runSelectedSql",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == sql && !suggestWidgetVisible"
      }
    ],
    "icons": {
      "bisql-logo": {
        "description": "BiSql logo",
        "default": {
          "fontPath": "./media/bisql-icons.woff",
          "fontCharacter": "\\EA01"
        }
      }
    },
    "grammars": [
      {
        "injectTo": [
          "source.python"
        ],
        "scopeName": "python-sql.injection",
        "path": "./syntaxes/python-sql.injection.json",
        "embeddedLanguages": {
          "meta.embedded.block.sql": "sql"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run typecheck && node ./scripts/esbuild.js --production",
    "compile": "npm run typecheck && node ./scripts/esbuild.js",
    "watch": "node ./scripts/esbuild.js --watch",
    "typecheck": "tsc -p ./ --noEmit",
    "package": "node --require ./scripts/patch-cpus.cjs ./node_modules/@vscode/vsce/vsce package --allow-missing-repository --allow-package-all-secrets",
    "reinstall": "bash ./scripts/reinstall.sh",
    "publish:ovsx": "bash ./scripts/publish-ovsx.sh"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^9.0.3",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "mssql": "^12.7.0",
    "mysql2": "^3.23.4",
    "pg": "^8.23.0",
    "sql-formatter": "^15.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^20.19.0",
    "@types/pg": "^8.23.1",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  }
}
