{
  "name": "bisql",
  "displayName": "BiSql",
  "description": "Schema-aware validation, IntelliSense, hover and format for SQL Server, MySQL, and PostgreSQL queries embedded in Python strings.",
  "version": "0.3.6",
  "publisher": "brachya",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "python",
    "sql",
    "mssql",
    "sql server",
    "mysql",
    "mariadb",
    "postgres",
    "postgresql",
    "intellisense"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:python",
    "onLanguage:sql",
    "onCommand:bisql.openConnectionPanel",
    "onCommand:bisql.runSelectedSql",
    "onCommand:bisql.formatSqlInFile"
  ],
  "contributes": {
    "configuration": {
      "title": "BiSql",
      "properties": {
        "bisql.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable SQL validation, completion and hover inside Python files and SQL files."
        },
        "bisql.engine": {
          "type": "string",
          "enum": [
            "mssql",
            "mysql",
            "postgres"
          ],
          "default": "mssql",
          "enumDescriptions": [
            "Keep using Microsoft SQL Server",
            "Use MySQL or MariaDB instead for this connection",
            "Use PostgreSQL instead for this connection"
          ],
          "description": "Which database engine to use. SQL Server, MySQL, and PostgreSQL are supported."
        },
        "bisql.server": {
          "type": "string",
          "default": "",
          "description": "Database host name or IP. For SQL Server, named instances use host\\\\INSTANCE."
        },
        "bisql.database": {
          "type": "string",
          "default": "",
          "description": "Default database for the live connection, dry-run, and when the same table name exists in more than one selected database."
        },
        "bisql.databases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Databases to load schema from. The default database is always included. When the same table name exists in more than one, the default database is used unless the name is qualified."
        },
        "bisql.user": {
          "type": "string",
          "default": "",
          "description": "Database login name. A read-only login is strongly recommended."
        },
        "bisql.password": {
          "type": "string",
          "default": "",
          "markdownDescription": "Fallback password, stored in plain text in settings. Prefer the login page or **Set Password**, which stores the password in the OS keychain."
        },
        "bisql.port": {
          "type": "number",
          "default": 1433,
          "minimum": 1,
          "maximum": 65535,
          "markdownDescription": "TCP port. Defaults: SQL Server `1433`, MySQL `3306`, PostgreSQL `5432`."
        },
        "bisql.encrypt": {
          "type": "boolean",
          "default": true,
          "description": "Encrypt the connection (TLS). For local SQL Server you may need Trust server certificate. For MySQL and PostgreSQL this maps to ssl."
        },
        "bisql.trustServerCertificate": {
          "type": "boolean",
          "default": false,
          "description": "Trust a self-signed server certificate (SQL Server) or skip TLS cert verification (MySQL / PostgreSQL)."
        },
        "bisql.connectionTimeout": {
          "type": "number",
          "default": 15000,
          "minimum": 1000,
          "description": "Connection and request timeout in milliseconds."
        },
        "bisql.schemaRefreshMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "description": "How often to refresh cached schema metadata, in minutes. Set to 0 to refresh only on demand."
        },
        "bisql.validateOnType": {
          "type": "boolean",
          "default": true,
          "description": "Run the fast offline metadata check while typing. The database is never contacted for this pass."
        },
        "bisql.dryRunOnSave": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "On open/save, dry-run the query: SQL Server uses `SET NOEXEC ON`; MySQL and PostgreSQL use `EXPLAIN` (parse/plan only, no data changes)."
        },
        "bisql.detectByKeyword": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Also treat any Python string that begins with a SQL keyword (`SELECT`, `INSERT`, `UPDATE`, ...) as SQL, even without an `--sql` marker or a recognised variable name."
        },
        "bisql.promptQuickSuggestions": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Offer, once, to enable `editor.quickSuggestions.strings` for Python. Without that setting VS Code will not pop the suggestion list while you type letters inside a string."
        },
        "bisql.cacheSchemaToDisk": {
          "type": "boolean",
          "default": true,
          "description": "Save a snapshot of the schema to local disk so suggestions work immediately at startup and while offline. Table and column names are written to the extension's global storage folder."
        },
        "bisql.queryMaxRows": {
          "type": "number",
          "default": 1000,
          "minimum": 1,
          "maximum": 10000,
          "description": "Rows per page for Run Selected SQL. Default 1000. Use Next/Previous in the results tab to see more. Click a column header to sort."
        },
        "bisql.formatKeywordCase": {
          "type": "string",
          "enum": [
            "upper",
            "lower",
            "preserve"
          ],
          "default": "upper",
          "enumDescriptions": [
            "UPPERCASE SQL keywords (SELECT, FROM, WHERE)",
            "lowercase SQL keywords (select, from, where)",
            "Leave keyword case as written"
          ],
          "description": "Keyword case when formatting SQL inside Python strings and in SQL files."
        },
        "bisql.formatTabWidth": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 8,
          "description": "Spaces per indent level when formatting SQL inside Python strings and in SQL files."
        },
        "bisql.mcpEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Register a localhost MCP server so Cursor's agent can use the live BiSql connection and schema cache."
        },
        "bisql.mcpAllowMutating": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Allow the Cursor agent to run `INSERT` / `UPDATE` / `DELETE` / DDL through MCP. The tool call must also pass `allow_mutating: true`. Prefer a read-only database login."
        },
        "bisql.mcpMaxResultRows": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 1000,
          "description": "Max rows returned to the Cursor agent in one MCP tool reply. The results tab can still show bisql.queryMaxRows."
        }
      }
    },
    "commands": [
      {
        "command": "bisql.openConnectionPanel",
        "title": "Open Connection / Login",
        "category": "BiSql",
        "icon": "$(key)"
      },
      {
        "command": "bisql.openSchemaExplorer",
        "title": "Browse Cached Schema",
        "category": "BiSql",
        "icon": "$(table)"
      },
      {
        "command": "bisql.setPassword",
        "title": "Set Password",
        "category": "BiSql"
      },
      {
        "command": "bisql.clearPassword",
        "title": "Clear Stored Password",
        "category": "BiSql"
      },
      {
        "command": "bisql.refreshSchema",
        "title": "Refresh Database Schema",
        "category": "BiSql"
      },
      {
        "command": "bisql.testConnection",
        "title": "Test Connection",
        "category": "BiSql"
      },
      {
        "command": "bisql.validateCurrentFile",
        "title": "Validate Current File",
        "category": "BiSql"
      },
      {
        "command": "bisql.enableInlineSuggestions",
        "title": "Enable Suggestions Inside Python Strings",
        "category": "BiSql"
      },
      {
        "command": "bisql.clearSchemaCache",
        "title": "Clear Cached Schema Snapshot",
        "category": "BiSql"
      },
      {
        "command": "bisql.runSelectedSql",
        "title": "Run Selected SQL",
        "category": "BiSql",
        "icon": "$(play)"
      },
      {
        "command": "bisql.formatSqlInFile",
        "title": "Format SQL in File",
        "category": "BiSql",
        "icon": "$(symbol-ruler)"
      },
      {
        "command": "bisql.formatSqlAt",
        "title": "Format SQL",
        "category": "BiSql",
        "icon": "$(symbol-ruler)"
      },
      {
        "command": "bisql.explainSqlAt",
        "title": "Explain SQL",
        "category": "BiSql",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "bisql.validateSqlAt",
        "title": "Validate SQL",
        "category": "BiSql",
        "icon": "$(verified)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "bisql.openConnectionPanel"
        },
        {
          "command": "bisql.openSchemaExplorer"
        },
        {
          "command": "bisql.setPassword"
        },
        {
          "command": "bisql.clearPassword"
        },
        {
          "command": "bisql.refreshSchema"
        },
        {
          "command": "bisql.testConnection"
        },
        {
          "command": "bisql.validateCurrentFile"
        },
        {
          "command": "bisql.enableInlineSuggestions"
        },
        {
          "command": "bisql.clearSchemaCache"
        },
        {
          "command": "bisql.runSelectedSql"
        },
        {
          "command": "bisql.formatSqlInFile"
        },
        {
          "command": "bisql.formatSqlAt",
          "when": "false"
        },
        {
          "command": "bisql.explainSqlAt",
          "when": "false"
        },
        {
          "command": "bisql.validateSqlAt",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "bisql.runSelectedSql",
          "when": "editorHasSelection || editorLangId == sql",
          "group": "bisql@1"
        },
        {
          "command": "bisql.formatSqlInFile",
          "when": "editorLangId == python || editorLangId == sql",
          "group": "bisql@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "bisql.runSelectedSql",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == sql && !suggestWidgetVisible"
      }
    ],
    "icons": {
      "bisql-logo": {
        "description": "BiSql logo",
        "default": {
          "fontPath": "./media/bisql-icons.woff",
          "fontCharacter": "\\EA01"
        }
      }
    },
    "grammars": [
      {
        "injectTo": [
          "source.python"
        ],
        "scopeName": "python-sql.injection",
        "path": "./syntaxes/python-sql.injection.json",
        "embeddedLanguages": {
          "meta.embedded.block.sql": "sql"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run typecheck && node ./scripts/esbuild.js --production",
    "compile": "npm run typecheck && node ./scripts/esbuild.js",
    "watch": "node ./scripts/esbuild.js --watch",
    "typecheck": "tsc -p ./ --noEmit",
    "package": "node --require ./scripts/patch-cpus.cjs ./node_modules/@vscode/vsce/vsce package --allow-missing-repository --allow-package-all-secrets",
    "reinstall": "bash ./scripts/reinstall.sh",
    "publish:ovsx": "bash ./scripts/publish-ovsx.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "mssql": "^12.7.0",
    "mysql2": "^3.23.4",
    "pg": "^8.23.0",
    "sql-formatter": "^15.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^20.19.0",
    "@types/pg": "^8.23.1",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  }
}
