{
  "scopeName": "python-sql.injection",
  "injectionSelector": "L:source.python -string -comment",
  "patterns": [
    {
      "name": "meta.embedded.block.sql",
      "begin": "(?i)\\b((?:[A-Za-z_][A-Za-z0-9_]*)?(?:query|stmt|statement)[A-Za-z0-9_]*|(?:[A-Za-z_][A-Za-z0-9_]*_)?sql(?:_[A-Za-z0-9]+|[0-9]+)*)\\b\\s*(:\\s*\\w+\\s*)?=\\s*([rRfFbBuU]{0,2})(\"\"\"|''')",
      "beginCaptures": {
        "1": { "name": "variable.other.python" },
        "3": { "name": "storage.type.string.python" },
        "4": { "name": "punctuation.definition.string.begin.python" }
      },
      "end": "(\\4)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.string.end.python" }
      },
      "patterns": [
        { "include": "source.sql" }
      ]
    },
    {
      "name": "meta.embedded.block.sql",
      "begin": "(?i)\\b((?:[A-Za-z_][A-Za-z0-9_]*)?(?:query|stmt|statement)[A-Za-z0-9_]*|(?:[A-Za-z_][A-Za-z0-9_]*_)?sql(?:_[A-Za-z0-9]+|[0-9]+)*)\\b\\s*(:\\s*\\w+\\s*)?=\\s*([rRfFbBuU]{0,2})(\"|')",
